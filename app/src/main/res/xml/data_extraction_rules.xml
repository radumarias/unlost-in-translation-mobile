<?xml version="1.0" encoding="utf-8"?><!--
   Backup and transfer rules from API 31 up (backup_rules.xml covers older
   devices). The Room database is the user's complete translation history -
   personal content, excluded from both cloud backup and device-to-device
   transfer (audit F3; decision 2026-07-17: exclude).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="." />
    </device-transfer>
</data-extraction-rules>
