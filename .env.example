# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# RELAY_BASE_URL: the two-device conversation relay (issue #33), as a wss:// origin
# with no trailing slash — e.g. wss://uitr-relay.<subdomain>.workers.dev
# Deploy `relay/` with `wrangler deploy` and paste the hostname here. Left empty,
# remote conversation mode reports itself unconfigured and stays switched off;
# nothing else in the app is affected.
RELAY_BASE_URL=

# WEB_BASE_URL: origin of the deployed web build, e.g. https://translate.example.com
# (no trailing slash). Not a secret. Set, the pairing QR carries an https link instead
# of the compact `uitr:` form, so a stock camera app can act on it: the installed
# Android app claims it through the App Link in the manifest, and a phone without the
# app opens the web build instead. It is also the host the manifest filter names, so
# the site must serve /.well-known/assetlinks.json — see relay/README.md and HANDOFF.md.
# Left empty, the QR stays compact and only this app's own scanner can read it.
WEB_BASE_URL=
