# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# RELAY_BASE_URL: the two-device conversation relay (issue #33), as a wss:// origin
# with no trailing slash — e.g. wss://uitr-relay.<subdomain>.workers.dev
# Deploy `relay/` with `wrangler deploy` and paste the hostname here. Left empty,
# remote conversation mode reports itself unconfigured and stays switched off;
# nothing else in the app is affected.
RELAY_BASE_URL=
